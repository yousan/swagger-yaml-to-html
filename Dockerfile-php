FROM php:8.3-cli-alpine

RUN apk add --no-cache yaml \
 && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS yaml-dev \
 && pecl install yaml \
 && docker-php-ext-enable yaml \
 && apk del .build-deps

WORKDIR /usr/src/app

COPY swagger-yaml-to-html.php ./

CMD [ "php", "./swagger-yaml-to-html.php" ]
